---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/ui/Navigation';
import Footer from '../../components/ui/Footer';
import LagoonMap from '../../components/map/LagoonMap';
import TimelineStratigraphic from '../../components/timeline/TimelineStratigraphic';
import FossilGallery from '../../components/gallery/FossilGallery';
---

<Layout title="Ecosistemas Lagunares" section="Paleoentomología">
  <Navigation client:load currentSection="002" />
  
  <main class="container" style="padding-top: 8rem;">
    <div class="text-center">
      <span class="stratum-label">ESTRATO I: EL LUGAR</span>
      <h1 class="mb-4" style="font-family: var(--font-display); font-size: 3rem; color: var(--ink);">Las Lagunas de la Alta Montaña</h1>
      <p class="prose mx-auto mb-12">
        Los sedimentos de las lagunas del Páramo de Frontino y la Sierra Nevada del Cocuy 
        son archivos milenarios. Aquí leemos el tiempo hacia atrás, capa por capa.
      </p>
    </div>

    <!-- The Map -->
    <LagoonMap client:visible />

    <div class="separator">
      <span class="separator-ornament">❧</span>
    </div>

    <!-- The Timeline -->
    <section class="section">
      <h2 class="text-center mb-12" style="font-family: var(--font-display);">Estratigrafía Temporal</h2>
      <TimelineStratigraphic client:visible />
    </section>

    <div class="separator">
      <span class="separator-ornament">❧</span>
    </div>

    <!-- The Fossil Gallery -->
    <section class="section">
      <h2 class="text-center mb-4" style="font-family: var(--font-display);">Catálogo de Especímenes</h2>
      <p class="prose mx-auto text-center mb-8">
        Coleópteros y dípteros fosilizados en los sedimentos lagunares, testigos mudos de los cambios climáticos del Pleistoceno.
      </p>
      <FossilGallery client:load />
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .text-center { text-align: center; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .mb-4 { margin-bottom: 1rem; }
  .mb-8 { margin-bottom: 2rem; }
  .mb-12 { margin-bottom: 3rem; }
</style>
