---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/ui/Navigation';
import Footer from '../../components/ui/Footer';
import CrossReference from '../../components/crosses/CrossReference';

const crosses = await getCollection('crosses');
// Sort by number, then camus first
const sortedCrosses = crosses.sort((a, b) => {
  if (a.data.author !== b.data.author) {
    return a.data.author === 'camus' ? -1 : 1;
  }
  return a.data.number - b.data.number;
});
---

<Layout title="Los Cruces" section="Intouchables & Literatura">
  <Navigation client:load currentSection="001" />
  
  <main class="container" style="padding-top: 8rem;">
    <h1 class="mb-4">Los Cruces</h1>
    <p class="prose mb-12">
      Ocho puntos de convergencia entre la película <em>Intouchables</em> y la literatura francesa contemporánea.
    </p>

    <div class="crosses-list">
      {sortedCrosses.map(cross => (
        <CrossReference 
          client:visible
          filmContent={cross.data.filmConcept}
          literaryContent={cross.data.literaryConcept}
          quote={cross.data.camusQuote || cross.data.ernauxQuote}
          analysis={cross.data.crossAnalysis}
          author={cross.data.author}
          catalogNumber={cross.data.catalogNumber}
          references={cross.data.references}
        />
      ))}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .mb-4 { margin-bottom: 1rem; }
  .mb-12 { margin-bottom: 3rem; }
  
  .crosses-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
</style>
